@model EQLWebAPIWithAngular.Models.Organization

@{
    ViewData["Title"] = "Edit";
}

<div class="container">

    <div class="row justify-content-center align-items-center edit_form">
        <div class="col-md-5 col-sm-10 col-12">
            <div class="form_header"><h1>Edit Organization</h1></div>
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Address" class="control-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ContactNo" class="control-label"></label>
                    <input asp-for="ContactNo" class="form-control" />
                    <span asp-validation-for="ContactNo" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ContactEmail" class="control-label"></label>
                    <input asp-for="ContactEmail" class="form-control" />
                    <span asp-validation-for="ContactEmail" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ContactPerson" class="control-label"></label>
                    <input asp-for="ContactPerson" class="form-control" />
                    <span asp-validation-for="ContactPerson" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="RegisteredOn" class="control-label"></label>
                    <input type="date" asp-for="RegisteredOn" class="form-control" />
                    <span asp-validation-for="RegisteredOn" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Expiry" class="control-label"></label>
                    <input type="date" asp-for="Expiry" class="form-control" />
                    <span asp-validation-for="Expiry" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Timezone_Mins" class="control-label"></label>
                    <input asp-for="Timezone_Mins" class="form-control" />
                    <span asp-validation-for="Timezone_Mins" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <div class="checkbox">
                        <label>
                            <input asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="RouteName" class="control-label"></label>
                    <input asp-for="RouteName" class="form-control" />
                    <span asp-validation-for="RouteName" class="text-danger"></span>
                </div>

                <div class="form-group text-center">
                    <input type="submit" value="Update" class="save" />
                    <button class="cancel" asp-action="Index">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index" style="color:white">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
