                        @Html.DisplayFor(model => model.RouteName)
                    </dd>
                </dl>
                <div class="row">
                    <a asp-action="Edit" class="save" style="margin-left: 10%;float: left;background-image: linear-gradient(to bottom right, #91a29f, #42494c);" asp-route-id="@Model.Id">Edit</a> &nbsp;
                    <a asp-action="Index" class="save" style="margin-left: 25%;">Back to List</a>
                </div>
            </form>

        </div>
    </div>
</div>

