@model EQLWebAPIWithAngular.Models.Login

@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login</title>
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.1/css/all.css">
    <link rel="stylesheet" href="~/css/bootstrap.css">
    <link rel="stylesheet" href="~/css/style.css">
    <script type="text/javascript" src="j~/s/jquery-3.3.1.min.js"></script>
    <script type="text/javascript" src="~/js/bootstrap.js"></script>
</head>
<body>
    <header>
        <div class="container">
            <div class="row align-items-center justify-content-space-between">
                <div class="col-md-6">
                    <a href="index.html"><img height="45px" src="~/images/logo.png" alt=""></a>
                </div>
                
            </div>
        </div>
    </header>
    <div class="container">

        <div class="row justify-content-center align-items-center edit_form">
            <div class="col-md-5 col-sm-10 col-12">
                <div class="form_header"><h1>Login</h1></div>
                <form asp-action="Login">
                    <div class="form-group">
                        <input type="text" asp-for="UserName" class="form-control user" placeholder="Name">
                    </div>
                    <div class="form-group">
                        <input type="password" asp-for="Password" class="form-control password" placeholder="Password">
                    </div>
                    <div class="form-group text-center">
                        <button class="save">Log In</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>