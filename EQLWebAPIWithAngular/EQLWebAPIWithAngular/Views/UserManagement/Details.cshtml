@model EQLWebAPIWithAngular.Models.User

@{
    ViewData["Title"] = "Details";
}

<style>
    .edit_form .form_header {
        background-image: linear-gradient(to top right, #33a0b7, #75dac7);
        border-radius: 5px 5px 0px 0px;
        padding: 20px 20px;
        text-align: left;
        width: 500px;
    }

    .edit_form form {
        background-color: #ffffff;
        width: 500px;
        height: 80px;
        padding: unset;
        border-radius: 0px 0px 5px 5px;
    }

    .edit_form .save {
        margin-right: 20px;
        margin-left: 20px;
        margin-top: 20px;
        margin-bottom: 5px;
        float: right;
    }

    .edit_form .cancel {
        margin-right: 20px;
        margin-left: 20px;
        margin-top: 20px;
        margin-bottom: 5px;
        float: left;
    }
</style>

<div class="container">

    <div class="row justify-content-center align-items-center edit_form">
        <div class="col-md-5 col-sm-10 col-12">
            <div class="form_header">
                <div class="row">
                    <h3 style="margin-top: -4px;margin-left: 20px;margin-right: 10px;">Details</h3> <h1>:</h1>
                    <h1 style="margin-left: 10px;">User</h1>
                </div>
                <hr />

                <dl class="dl-horizontal">
                    <dt>
                        @Html.DisplayNameFor(model => model.FirstName)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.FirstName)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.LastName)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.LastName)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.UserName)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.UserName)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.Password)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.Password)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.Email)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.Email)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.Expiry)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.Expiry)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.IsActive)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.Organization)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.Organization.Name)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.UserType)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.UserType.Type)
                    </dd>
                </dl>
            </div>
            <form action="" class="text-center">
                <a asp-action="Edit" class="save" style="float: left;background-image: linear-gradient(to bottom right, #91a29f, #42494c);" asp-route-id="@Model.Id">Edit</a> &nbsp;
                <a asp-action="Index" class="save">Back to List</a>
            </form>

        </div>
    </div>
</div>

